        "credentialCode": {
          "type": "string",
          "description": "Unique serial code (SLQ-FC-... or SLQ-RC-...).",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "credentialType": {
          "type": "string",
          "description": "Credential surface type.",
          "enum": ["flexcard", "report_card"],
          "maxLength": 20
        },
        "ownerUid": {
          "type": "string",
          "description": "Candidate owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "candidateName": {
          "type": "string",
          "description": "Candidate display name printed on the credential.",
          "minLength": 1,
          "maxLength": 80
        },
        "boardOrUniversity": {
          "type": "string",
          "description": "Board or university printed on the credential.",
          "minLength": 0,
          "maxLength": 120
        },
        "examName": {
          "type": "string",
          "description": "Target examination printed on the credential.",
          "minLength": 0,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "description": "Achievement headline or Official Academic Report Card title.",
          "minLength": 1,
          "maxLength": 120
        },
        "metricSummary": {
          "type": "string",
          "description": "Verified performance metric summary.",
          "minLength": 1,
          "maxLength": 200
        },
        "xpPoints": {
          "type": "integer",
          "description": "Candidate net XP at issuance."
        },
        "flexTier": {
          "type": "string",
          "description": "FlexCard rarity tier at issuance.",
          "minLength": 1,
          "maxLength": 40
        },
        "issuedDate": {
          "type": "string",
          "description": "ISO date of issuance.",
          "minLength": 1,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "credentialCode",
        "credentialType",
        "ownerUid",
        "candidateName",
        "boardOrUniversity",
        "examName",
        "title",
        "metricSummary",
        "xpPoints",
        "flexTier",
        "issuedDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "CredentialVerification": {
      "title": "CredentialVerification",
      "description": "Notification record sent to a candidate when a non-admin verifies their FlexCard or Report Card serial.",
      "type": "object",
      "properties": {
        "verificationId": {
          "type": "string",
          "description": "Verification record ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "credentialCode": {
          "type": "string",
          "description": "Verified serial code.",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "credentialType": {
          "type": "string",
          "description": "Credential surface type.",
          "enum": ["flexcard", "report_card"],
          "maxLength": 20
        },
        "targetUserId": {
          "type": "string",
          "description": "Candidate UID notified of the verification.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "credentialTitle": {
          "type": "string",
          "description": "Title of the verified FlexCard or Report Card.",
          "minLength": 1,
          "maxLength": 120
        },
        "verifierUid": {
          "type": "string",
          "description": "Authenticated UID of the non-admin verifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "verifierName": {
          "type": "string",
          "description": "Full name provided by the non-admin verifier.",
          "minLength": 2,
          "maxLength": 80
        },
        "verifierGmail": {
          "type": "string",
          "format": "email",
          "description": "Gmail address provided by the non-admin verifier.",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[^@\\s]+@gmail\\.com$"
        },
        "verifierPost": {
          "type": "string",
          "description": "Declared role/post of the verifier.",
          "enum": ["teacher", "company_executive", "student"],
          "maxLength": 32
        },
        "verifiedAtDate": {
          "type": "string",
          "description": "ISO date of verification.",
          "minLength": 1,
          "maxLength": 20
        },
        "acknowledged": {
          "type": "boolean",
          "description": "Whether the candidate has dismissed/read the verification alert."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "verificationId",
        "credentialCode",
        "credentialType",
        "targetUserId",
        "credentialTitle",
        "verifierUid",
        "verifierName",
        "verifierGmail",
        "verifierPost",
        "verifiedAtDate",
        "acknowledged",
        "createdAt",
        "updatedAt"
      ]
    },
    "SocialProfile": {
      "title": "SocialProfile",
      "description": "Zero-PII scholar directory card for Social SyllabiQ Profile ID lookup.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated scholar UID.",
          "minLength": 1,
          "maxLength": 128,
